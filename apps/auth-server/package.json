{
  "name": "@saral/auth-server",
  "version": "1.0.0",
  "description": "SARAL Protocol — Minimal Asymmetric Authentication Server with Prisma ORM",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate deploy",
    "prisma:push": "npx prisma db push"
  },
  "type": "commonjs",
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "prisma": "^6.19.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "effect": "3.22.1"
  }
}
