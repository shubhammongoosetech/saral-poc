# SARAL Wallet Backend — Environment Template
# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL 16 with Prisma ORM)
DATABASE_URL=postgresql://saral:saral_secret@localhost:5432/saral

# JWT / Auth Secrets (must be >= 32 chars in production)
JWT_SECRET=saral_dev_jwt_secret_key_2024_change_me_min32
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=saral_refresh_secret_change_in_production_min_32_ch
CSRF_SECRET=saral_csrf_secret_change_min16
MFA_ENCRYPTION_KEY=saral-mfa-protection-key-2026-v3
OTP_PEPPER=saral-otp-cryptographic-pepper-2026

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Token TTLs
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/login

# SMS (OTP delivery)
SMS_PROVIDER_KEY=dev-sms-key

# Blockchain RPC
RPC_URL=https://testnetrpc.mstblockchain.com
CHAIN_ID=91562037

# Node topology (5 per domain, threshold 3)
SARAL_FOUNDATION_NODES=5
SARAL_PUBLIC_NODES=5
SARAL_PRIVATE_NODES=5
SARAL_FOUNDATION_THRESHOLD=3
SARAL_PUBLIC_THRESHOLD=3
SARAL_PRIVATE_THRESHOLD=3
# Rules: each count >= 3, threshold > count/2, threshold <= count.
# Total nodes = sum of the three counts (not configurable).

# Node storage behaviour
SARAL_REUSE_EXISTING_CONTAINERS=true
SARAL_CREATE_CONTAINERS_ON_LOGIN=false
SARAL_PERSISTENT_NODE_STORAGE=true
