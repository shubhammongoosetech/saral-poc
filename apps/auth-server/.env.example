# ==============================================================================
# SARAL AUTH SERVER — ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env and configure real credentials. Never commit secrets.

# Server & Runtime
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
ENABLE_DEV_AUTH=false

# Database (PostgreSQL 16 with Prisma ORM)
DATABASE_URL=postgresql://saral:saral_secret@localhost:5432/saral

# Secrets & Encryption Keys (Must be >= 32 characters in production)
JWT_SECRET=saral_dev_jwt_secret_key_2024_change_me_min32
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=saral_refresh_secret_change_in_production_min_32_ch
CSRF_SECRET=saral_csrf_secret_change_min16
MFA_ENCRYPTION_KEY=
OTP_PEPPER=

# Token TTLs
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/login
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# EdDSA JWT / JWKS
SARAL_JWT_ISSUER=saral-auth-server
SARAL_JWT_AUDIENCE=saral-node-committee
SARAL_JWT_ACTIVE_KID=saral-auth-ed25519-2026-01
KEY_DIR=infra/config

# SARAL Node & Mesh Backend
SARAL_NODE_URL=http://localhost:8001
SARAL_NODE_FOUNDATION_URL=http://localhost:8001
SARAL_NODE_PUBLIC_URL=http://localhost:8006
SARAL_NODE_PRIVATE_URL=http://localhost:8011
AUTH_SERVER_URL=http://localhost:3001
SARAL_INTERNAL_TOKEN=saral-mesh-secure-internal-token-v3
SARAL_ADMIN_KEY=saral-mesh-admin-secret-2026

# 15-Node Distributed Topology (5 per domain, threshold 3)
SARAL_FOUNDATION_NODES=5
SARAL_PUBLIC_NODES=5
SARAL_PRIVATE_NODES=5
SARAL_FOUNDATION_THRESHOLD=3
SARAL_PUBLIC_THRESHOLD=3
SARAL_PRIVATE_THRESHOLD=3

# Multi-Chain Blockchain RPCs
MST_RPC_URL=https://testnetrpc.mstblockchain.com
CHAIN_ID=91562037
SOLANA_RPC_URL=https://api.devnet.solana.com
BITCOIN_API_URL=https://blockstream.info/testnet/api

# Logging
LOG_LEVEL=info
