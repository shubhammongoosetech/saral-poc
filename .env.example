# SARAL Protocol — Root Environment Configuration Template
# Copy this file to .env or individual service .env files.
# NEVER commit real credentials, private keys, or passwords.

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://saral:saral_secret@localhost:5432/saral
POSTGRES_USER=saral
POSTGRES_PASSWORD=saral_secret
POSTGRES_DB=saral

# Auth Server
PORT=3001
NODE_ENV=development
ENABLE_DEV_AUTH=true
JWT_SECRET=saral_dev_jwt_secret_key_2024_change_me_min32
MFA_ENCRYPTION_KEY=saral-mfa-protection-key-2026-v3
OTP_PEPPER=saral-otp-cryptographic-pepper-2026

# Frontend (Vite)
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 15-Node Distributed Topology (5 per domain, threshold 3)
SARAL_FOUNDATION_NODES=5
SARAL_PUBLIC_NODES=5
SARAL_PRIVATE_NODES=5
SARAL_FOUNDATION_THRESHOLD=3
SARAL_PUBLIC_THRESHOLD=3
SARAL_PRIVATE_THRESHOLD=3

# Blockchain RPCs
MST_RPC_URL=https://testnetrpc.mstblockchain.com
CHAIN_ID=91562037
SOLANA_RPC_URL=https://api.devnet.solana.com
BITCOIN_API_URL=https://blockstream.info/testnet/api
