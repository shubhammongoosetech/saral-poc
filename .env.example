# ==============================================================================
# SARAL PROTOCOL — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the stack.
# NEVER commit real credentials, private keys, or production passwords.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Settings
# ------------------------------------------------------------------------------
# Environment mode: 'development', 'production', or 'test'
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Web Frontend (Vite)
# ------------------------------------------------------------------------------
# URL of the Auth Server backend accessed by the browser
VITE_API_URL=http://localhost:3001

# Google OAuth 2.0 Client ID for web frontend login
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth 2.0 Callback URL
VITE_GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ------------------------------------------------------------------------------
# 3. Auth Server (Node.js / Express)
# ------------------------------------------------------------------------------
# HTTP port for the Auth Server API
PORT=3001

# Allowed Origin for CORS requests from the Web frontend
FRONTEND_URL=http://localhost:5173

# Enable local developer authentication bypass (STRICTLY 'false' in production!)
ENABLE_DEV_AUTH=false

# Show active OTP token in response payload during development testing
AUTH_DEV_OTP_DISPLAY=false

# ------------------------------------------------------------------------------
# 4. PostgreSQL / Prisma ORM
# ------------------------------------------------------------------------------
# Database connection string used by Prisma Client
DATABASE_URL=postgresql://saral:saral_secret@localhost:5432/saral
DATABASE_URL_DOCKER=postgresql://saral:saral_secret@postgres:5432/saral

# PostgreSQL Docker container credentials
POSTGRES_USER=saral
POSTGRES_PASSWORD=saral_secret
POSTGRES_DB=saral

# ------------------------------------------------------------------------------
# 5. Google OAuth 2.0
# ------------------------------------------------------------------------------
# Client ID for backend token validation
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Client Secret (must be rotated in Google Cloud Console if exposed)
GOOGLE_CLIENT_SECRET=REPLACE_WITH_MIN_32_CHAR_RANDOM_SECRET_IN_PRODUCTION

# OAuth callback redirect URI
GOOGLE_REDIRECT_URI=http://localhost:5173/login

# OAuth backend callback endpoint
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ------------------------------------------------------------------------------
# 6. Phone OTP Authentication
# ------------------------------------------------------------------------------
# Cryptographic pepper for HMAC-SHA256 phone OTP code hashing (minimum 32 chars)
OTP_PEPPER=REPLACE_WITH_MIN_32_CHAR_RANDOM_SECRET_IN_PRODUCTION

# ------------------------------------------------------------------------------
# 7. Multi-Factor Authentication (MFA / TOTP)
# ------------------------------------------------------------------------------
# AES-256 encryption key used to encrypt TOTP secrets before database storage (minimum 32 chars)
MFA_ENCRYPTION_KEY=REPLACE_WITH_MIN_32_CHAR_RANDOM_SECRET_IN_PRODUCTION

# ------------------------------------------------------------------------------
# 8. JWT / JWKS (EdDSA Asymmetric Authentication)
# ------------------------------------------------------------------------------
# Symmetric secret fallback for session tokens (minimum 32 characters in production)
JWT_SECRET=REPLACE_WITH_MIN_32_CHAR_RANDOM_SECRET_IN_PRODUCTION
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=REPLACE_WITH_MIN_32_CHAR_RANDOM_SECRET_IN_PRODUCTION
CSRF_SECRET=REPLACE_WITH_MIN_32_CHAR_RANDOM_SECRET_IN_PRODUCTION

# EdDSA JWT Issuer claim
SARAL_JWT_ISSUER=saral-auth-server

# EdDSA JWT Audience claim
SARAL_JWT_AUDIENCE=saral-domain-coordinators

# Active Key ID in JWKS key ring
SARAL_JWT_ACTIVE_KID=saral-auth-ed25519-2026-01

# Directory storing Ed25519 signing keys for token issuance
KEY_DIR=infra/config

# ------------------------------------------------------------------------------
# 9. SARAL Backend & Internal Mesh
# ------------------------------------------------------------------------------
# Go Coordinators for the 3 Sovereign Domains
COORDINATOR_URL=http://localhost:9001
FOUNDATION_COORDINATOR_URL=http://localhost:9001
PUBLIC_COORDINATOR_URL=http://localhost:9002
PRIVATE_COORDINATOR_URL=http://localhost:9003

# Auth Server URL for Go Verifiers to fetch JWKS and verify tokens
AUTH_SERVER_URL=http://localhost:3001

# Internal cluster bearer token for authenticated inter-service RPC (minimum 32 chars)
SARAL_INTERNAL_TOKEN=REPLACE_WITH_MIN_32_CHAR_RANDOM_SECRET_IN_PRODUCTION

# Timeout for 3-domain DKG consensus in milliseconds (tune for network latency, default 15000)
SARAL_DKG_TIMEOUT_MS=15000

# Path to internal token file (Docker secrets)
SARAL_INTERNAL_TOKEN_FILE=/run/secrets/saral_internal_token

# Administrative operator secret
SARAL_ADMIN_KEY=saral-mesh-admin-secret-2026

# Path to admin key file (Docker secrets)
SARAL_ADMIN_KEY_FILE=/run/secrets/saral_admin_key

# Ed25519 public key file path for Go verifiers and node authenticators
SARAL_AUTH_PUBLIC_KEY_FILE=/run/secrets/auth_ed25519_pub.pem

# Genesis cluster node registry file path
SARAL_GENESIS_REGISTRY_FILE=/run/secrets/saral_genesis_participants.json

# TLS certificates directory for mutual TLS (mTLS 1.3)
TLS_DIR=infra/tls

# ------------------------------------------------------------------------------
# 10. DKG & Threshold Topology (Single Source of Truth)
# ------------------------------------------------------------------------------
# Total committee nodes per domain (Foundation, Public, Private)
SARAL_FOUNDATION_NODES=5
SARAL_PUBLIC_NODES=5
SARAL_PRIVATE_NODES=5

# Threshold quorum k (3-of-5 threshold security per domain)
SARAL_FOUNDATION_THRESHOLD=3
SARAL_PUBLIC_THRESHOLD=3
SARAL_PRIVATE_THRESHOLD=3

# Fault Tolerance Parameters (Kate-Huang-Goldberg: n >= 3t + 2f + 1)
SARAL_FOUNDATION_FAULTS_T=1
SARAL_PUBLIC_FAULTS_T=1
SARAL_PRIVATE_FAULTS_T=1
SARAL_FOUNDATION_CRASH_F=0
SARAL_PUBLIC_CRASH_F=0
SARAL_PRIVATE_CRASH_F=0
SARAL_FAULTS_T=1
SARAL_CRASH_F=0
SARAL_HYBRID_DKG_TIMEOUT_MS=4000
SARAL_HYBRID_DKG_COLLECT_MS=150

# Node ID Prefixes & Explicit Lists
SARAL_FOUNDATION_NODE_PREFIX=saral-foundation-
SARAL_PUBLIC_NODE_PREFIX=saral-public-
SARAL_PRIVATE_NODE_PREFIX=saral-private-
SARAL_FOUNDATION_NODE_IDS=saral-foundation-1,saral-foundation-2,saral-foundation-3,saral-foundation-4,saral-foundation-5
SARAL_PUBLIC_NODE_IDS=saral-public-1,saral-public-2,saral-public-3,saral-public-4,saral-public-5
SARAL_PRIVATE_NODE_IDS=saral-private-1,saral-private-2,saral-private-3,saral-private-4,saral-private-5

# ------------------------------------------------------------------------------
# 11. Node Vaults
# ------------------------------------------------------------------------------
# Node vault directory for AES-256-GCM encrypted share persistence
VAULT_DIR=/vault

# ------------------------------------------------------------------------------
# 12. Blockchain RPC Networks
# ------------------------------------------------------------------------------
# MST EVM Testnet RPC
MST_RPC_URL=https://testnetrpc.mstblockchain.com
CHAIN_ID=91562037

# Solana Devnet RPC
SOLANA_RPC_URL=https://api.devnet.solana.com

# Bitcoin Testnet Blockstream API
BITCOIN_API_URL=https://blockstream.info/testnet/api

# ------------------------------------------------------------------------------
# 13. Logging & Telemetry
# ------------------------------------------------------------------------------
# Log level: 'debug', 'info', 'warn', 'error'
LOG_LEVEL=info
