# ==============================================================================
# SARAL PROTOCOL — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the stack.
# NEVER commit real credentials, private keys, or production passwords.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Settings
# ------------------------------------------------------------------------------
# Environment mode: 'development', 'production', or 'test'
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Web Frontend (Vite)
# ------------------------------------------------------------------------------
# URL of the Auth Server backend accessed by the browser
VITE_API_URL=http://localhost:3001

# Google OAuth 2.0 Client ID for web frontend login

# Google OAuth 2.0 Callback URL
VITE_GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ------------------------------------------------------------------------------
# 3. Auth Server (Node.js / Express)
# ------------------------------------------------------------------------------
# HTTP port for the Auth Server API
PORT=3001

# Allowed Origin for CORS requests from the Web frontend
FRONTEND_URL=http://localhost:5173

# Local-only demo authentication and OTP display. Leave disabled on shared deployments.
ENABLE_DEV_AUTH=false

# ------------------------------------------------------------------------------
# 4. PostgreSQL / Prisma ORM
# ------------------------------------------------------------------------------
# Database connection string used by Prisma Client
DATABASE_URL=postgresql://saral:saral_secret@localhost:5432/saral

# PostgreSQL Docker container credentials
POSTGRES_USER=saral
POSTGRES_PASSWORD=saral_secret
POSTGRES_DB=saral

# ------------------------------------------------------------------------------
# 5. Google OAuth 2.0
# ------------------------------------------------------------------------------
# Client ID for backend token validation
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Client Secret (optional for server-side token exchange)
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth callback redirect URI
GOOGLE_REDIRECT_URI=http://localhost:5173/login

# OAuth backend callback endpoint
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ------------------------------------------------------------------------------
# 6. Phone OTP Authentication
# ------------------------------------------------------------------------------
# The local developer phone OTP flow uses this pepper. Production requires SMS delivery.
OTP_PEPPER=

# ------------------------------------------------------------------------------
# 7. Multi-Factor Authentication (MFA / TOTP)
# ------------------------------------------------------------------------------
# Configure a persistent secret of at least 32 characters in production.
MFA_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 8. JWT / JWKS (EdDSA Asymmetric Authentication)
# ------------------------------------------------------------------------------
# Symmetric secret fallback for session tokens (minimum 32 characters in production)
JWT_SECRET=saral_dev_jwt_secret_key_2024_change_me_min32
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=saral_refresh_secret_change_in_production_min_32_ch
CSRF_SECRET=saral_csrf_secret_change_min16

# EdDSA JWT Issuer claim
SARAL_JWT_ISSUER=saral-auth-server

# EdDSA JWT Audience claim
SARAL_JWT_AUDIENCE=saral-domain-coordinators

# Active Key ID in JWKS key ring
SARAL_JWT_ACTIVE_KID=saral-auth-ed25519-2026-01

# Directory storing Ed25519 signing keys for token issuance
KEY_DIR=infra/config

# ------------------------------------------------------------------------------
# 9. SARAL Backend & Internal Node Mesh
# ------------------------------------------------------------------------------
# SARAL Node endpoints for Foundation, Public, and Private committee DKG operations
SARAL_NODE_URL=http://localhost:8001
SARAL_NODE_FOUNDATION_URL=http://localhost:8001
SARAL_NODE_PUBLIC_URL=http://localhost:8006
SARAL_NODE_PRIVATE_URL=http://localhost:8011

# Auth Server URL for node JWKS discovery and verification
AUTH_SERVER_URL=http://localhost:3001

# Internal cluster bearer token for authenticated inter-service RPC
SARAL_INTERNAL_TOKEN=saral-mesh-secure-internal-token-v3

# Path to internal token file (Docker secrets)
SARAL_INTERNAL_TOKEN_FILE=/run/secrets/saral_internal_token

# Administrative operator secret
SARAL_ADMIN_KEY=saral-mesh-admin-secret-2026

# Path to admin key file (Docker secrets)
SARAL_ADMIN_KEY_FILE=/run/secrets/saral_admin_key

# Ed25519 public key file path for node authenticators
SARAL_AUTH_PUBLIC_KEY_FILE=/run/secrets/auth_ed25519_pub.pem

# Genesis cluster node registry file path
SARAL_GENESIS_REGISTRY_FILE=/run/secrets/saral_genesis_participants.json

# TLS certificates directory for mutual TLS (mTLS 1.3)
TLS_DIR=infra/tls

# ------------------------------------------------------------------------------
# 10. DKG & Threshold Topology
# ------------------------------------------------------------------------------
# Total committee nodes per domain (Foundation, Public, Private)
SARAL_FOUNDATION_NODES=5
SARAL_PUBLIC_NODES=5
SARAL_PRIVATE_NODES=5

# Threshold quorum k (3-of-5 threshold security)
SARAL_FOUNDATION_THRESHOLD=3
SARAL_PUBLIC_THRESHOLD=3
SARAL_PRIVATE_THRESHOLD=3

# ------------------------------------------------------------------------------
# 11. Node Vaults
# ------------------------------------------------------------------------------
# Node vault directory for AES-256-GCM encrypted share persistence
VAULT_DIR=/vault

# ------------------------------------------------------------------------------
# 12. Blockchain RPC Networks
# ------------------------------------------------------------------------------
# MST EVM Testnet RPC
MST_RPC_URL=https://testnetrpc.mstblockchain.com
CHAIN_ID=91562037

# Solana Devnet RPC
SOLANA_RPC_URL=https://api.devnet.solana.com

# Bitcoin Testnet Blockstream API
BITCOIN_API_URL=https://blockstream.info/testnet/api

# ------------------------------------------------------------------------------
# 13. Logging & Telemetry
# ------------------------------------------------------------------------------
# Log level: 'debug', 'info', 'warn', 'error'
LOG_LEVEL=info
