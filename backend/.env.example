# SARAL Wallet Backend — Environment Template
# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/saral

# JWT / Auth Secrets (must be >= 32 chars in production)
JWT_SECRET=change_me_min_32_chars_jwt_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_me_min_32_chars_refresh
CSRF_SECRET=change_me_csrf_secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Token TTLs
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/login

# SMS (OTP delivery)
SMS_PROVIDER_KEY=your-sms-provider-key

# Blockchain RPC
RPC_URL=https://testnetrpc.mstblockchain.com
CHAIN_ID=91562037

# Node topology. These six values are the only place counts and thresholds are set.
SARAL_FOUNDATION_NODES=9
SARAL_PUBLIC_NODES=9
SARAL_PRIVATE_NODES=9
SARAL_FOUNDATION_THRESHOLD=5
SARAL_PUBLIC_THRESHOLD=5
SARAL_PRIVATE_THRESHOLD=5
# Rules: each count >= 3, threshold > count/2, threshold <= count.
# Total nodes = sum of the three counts (not configurable).

# Node storage behaviour
SARAL_REUSE_EXISTING_CONTAINERS=true
SARAL_CREATE_CONTAINERS_ON_LOGIN=false
SARAL_PERSISTENT_NODE_STORAGE=true
