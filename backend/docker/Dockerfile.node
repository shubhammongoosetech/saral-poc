# Multi-stage Dockerfile for SARAL Containerized MPC Node Daemon
# Node.js 26 Alpine Base
FROM node:26-alpine AS builder

WORKDIR /app

COPY package*.json tsconfig.json ./
COPY prisma ./prisma
RUN npm ci && npx prisma generate

COPY src ./src
RUN npm run build

FROM node:26-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV VAULT_DIR=/vault

RUN mkdir -p /vault && chmod 700 /vault

COPY package*.json ./
RUN npm ci --omit=dev

COPY --from=builder /app/dist ./dist

VOLUME ["/vault"]

EXPOSE 4000-4100

ENTRYPOINT ["node", "dist/participant/participantDaemonProcess.js"]

