generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String?  @db.VarChar(255)
  googleId    String?  @unique @map("google_id") @db.VarChar(255)
  email       String?  @unique @db.VarChar(255)
  mobile      String?  @unique @db.VarChar(50)
  loginMethod String   @map("login_method") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  mfa             Mfa?
  workPolicy      WorkPolicy?
  keyShares       KeyShare[]
  accessLogs      AccessLog[]
  transactions    Transaction[]
  otps            Otp[]
  securityLogs    SecurityEventLog[]
  placements      WalletPlacement[]

  @@map("users")
}

model Mfa {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @unique @map("user_id") @db.Uuid
  type       String    @default("otp") @db.VarChar(50)
  secret     String?   @db.Text
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa")
}

model WorkPolicy {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  startTime String   @map("start_time") @db.VarChar(10)
  endTime   String   @map("end_time") @db.VarChar(10)
  timezone  String   @default("Asia/Kolkata") @db.VarChar(100)
  city      String   @db.VarChar(255)
  lat       Float
  lng       Float
  radiusKm  Float    @default(25.0) @map("radius_km")
  setAt     DateTime @default(now()) @map("set_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("work_policy")
}

model KeyShare {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  category      String   @db.VarChar(50) // 'FOUNDATION' | 'PUBLIC' | 'PRIVATE' (or legacy 'INSTITUTIONAL' | 'SOVEREIGN')
  shareIndex    Int      @map("share_index")
  n             Int      @default(9)
  threshold     Int      @default(5)
  containerId   String   @map("container_id") @db.VarChar(100)
  containerName String   @map("container_name") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, shareIndex], name: "unique_user_category_share")
  @@index([userId])
  @@index([containerName])
  @@map("key_shares")
}

model AccessLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  attemptedAt DateTime @default(now()) @map("attempted_at") @db.Timestamptz
  lat         Float?
  lng         Float?
  allowed     Boolean
  reason      String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("access_logs")
}

model SecurityEventLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  eventType    String   @map("event_type") @db.VarChar(100)
  severity     String   @default("INFO") @db.VarChar(50)
  ipAddress    String?  @map("ip_address") @db.VarChar(100)
  userAgent    String?  @map("user_agent") @db.VarChar(255)
  details      String?  @db.Text
  previousHash String?  @map("previous_hash") @db.VarChar(64)
  entryHash    String?  @map("entry_hash") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, eventType])
  @@map("security_event_logs")
}

model Transaction {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  chain     String   @default("mst-testnet") @db.VarChar(50)
  txHash    String   @unique @map("tx_hash") @db.VarChar(255)
  toAddress String   @map("to_address") @db.VarChar(255)
  amount    String   @db.VarChar(100)
  status    String   @default("BROADCASTED") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model Otp {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  code      String   @db.VarChar(255)
  purpose   String   @db.VarChar(50) // 'login' | 'mfa'
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, used])
  @@map("otps")
}

model WalletPlacement {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  epoch               Int      @default(1)
  foundationNodes     String[] @map("foundation_nodes")
  publicNodes         String[] @map("public_nodes")
  privateNodes        String[] @map("private_nodes")
  foundationThreshold Int      @map("foundation_threshold")
  publicThreshold     Int      @map("public_threshold")
  privateThreshold    Int      @map("private_threshold")
  manifestHash        String   @map("manifest_hash") @db.VarChar(64)
  protocolVersion     String   @default("MPC-secp256k1-v1") @map("protocol_version") @db.VarChar(50)
  threshold           Int      @default(5)
  n                   Int      @default(9)
  pinnedAt            DateTime @default(now()) @map("pinned_at") @db.Timestamptz
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, epoch], name: "unique_user_epoch")
  @@index([userId])
  @@map("wallet_placements")
}

