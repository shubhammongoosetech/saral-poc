{
  "name": "backend",
  "version": "1.0.0",
  "description": "SARAL Wallet Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "node dist/server.js",
    "test": "tsx --test tests/*.test.ts",
    "topology:apply": "tsx src/topology/apply.ts",
    "nodes:start": "tsx src/nodes/nodeLauncher.ts",
    "docker:compose:gen": "tsx src/nodes/dockerComposeGen.ts",
    "typecheck": "tsc --noEmit",
    "db:clear": "tsx src/scripts/clearDb.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:migrate": "PGPASSWORD=saral_secret psql -h localhost -p 5433 -U saral -d saral -f src/db/schema.sql"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "ethers": "^6.17.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "google-auth-library": "^11.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^6.19.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
