{
  "name": "@saral/sdk-core",
  "version": "0.1.0",
  "description": "Shared types, errors, chain registry, adapters, and 3-domain MPC signing backends for SARAL",
  "author": "SARAL Team",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "^1.2.0",
    "@noble/hashes": "^1.3.2",
    "@solana/web3.js": "^1.98.0",
    "ethers": "^6.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}

