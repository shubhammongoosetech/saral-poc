{
  "name": "@saral/sdk-node",
  "version": "0.1.0",
  "description": "Node.js client for the SARAL 3-Domain Multi-Party Computation (MPC) Wallet",
  "author": "SARAL Team",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@saral/sdk-core": "*"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}

